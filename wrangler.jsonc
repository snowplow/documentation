{
  "name": "documentation",
  "compatibility_date": "2026-02-27",
  "main": "worker/index.js",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "vars": {
    "DOCS_ASSISTANT_AGENT_URL": "https://console.snowplowanalytics.com"
  },
  "ratelimits": [
    {
      "name": "ASSISTANT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
